# No VITE_API_URL needed — Vite proxy forwards /api/* to the backend.
# Override only if you need a different backend host in production:
# VITE_API_URL=https://your-production-api.example.com/api/v1

VITE_APP_NAME=Vital Signs Online

# ── Auth mode ──────────────────────────────────────────────────────────────
# backend  → email/password against /api/v1/auth/* (default; for local dev)
# oidc     → redirect to KeyCloak with Authorization Code + PKCE (production)
VITE_AUTH_MODE=backend

# ── OIDC settings (only used when VITE_AUTH_MODE=oidc) ─────────────────────
VITE_OIDC_AUTHORITY=https://101.42.46.218:8443/realms/vital-signs
VITE_OIDC_CLIENT_ID=vital-web
VITE_OIDC_REDIRECT_URI=https://101.42.46.218/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://101.42.46.218/
